{
  "name": "svg-png-preview",
  "displayName": "SVG & PNG Preview",
  "description": "Preview SVG and PNG files against the current VS Code editor background, with adaptive zoom controls.",
  "version": "0.1.1",
  "publisher": "jbearak",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/jbearak/image-preview.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "jbearak.imagePreview",
        "displayName": "SVG & PNG Preview",
        "selector": [
          {
            "filenamePattern": "*.[sS][vV][gG]"
          },
          {
            "filenamePattern": "*.[pP][nN][gG]"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "imagePreview.selectZoom",
        "title": "Select Zoom",
        "category": "SVG & PNG Preview"
      },
      {
        "command": "imagePreview.zoomIn",
        "title": "Zoom In",
        "category": "SVG & PNG Preview"
      },
      {
        "command": "imagePreview.zoomOut",
        "title": "Zoom Out",
        "category": "SVG & PNG Preview"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "imagePreview.selectZoom",
          "when": "activeCustomEditorId == 'jbearak.imagePreview'"
        },
        {
          "command": "imagePreview.zoomIn",
          "when": "activeCustomEditorId == 'jbearak.imagePreview'"
        },
        {
          "command": "imagePreview.zoomOut",
          "when": "activeCustomEditorId == 'jbearak.imagePreview'"
        }
      ]
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --test test/*.test.js",
    "package": "vsce package",
    "test": "npm run check"
  }
}
